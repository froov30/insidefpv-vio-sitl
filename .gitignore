# Vendored sources and their build outputs are far too large to commit.
# scripts/build.sh fetches them at pinned revisions on its first run and
# reuses the checkout afterwards.
third_party/
**/build/

# Python bytecode.
__pycache__/
*.pyc

# Runtime working directories. SITL writes eeprom.bin and DataFlash logs
# here, and run_sim.sh writes the pair's console logs here. None of it is
# source; the evidence that is kept lives under results/.
logs/sitl/
logs/sim/

# Working documentation. These are kept on disk and used while recording the
# walkthrough, but they are not part of the repository: README.md is the file a
# reviewer starts from, and everything they need to run the project is in
# scripts/, worlds/ and results/.
walkthrough/
DEFENCE.md
REPORT.md

# DataFlash logs are runtime output everywhere except in results/, where
# they are the flight evidence a reviewer is meant to open.
*.BIN
!results/**/*.BIN

# Recorded camera frames: ~27 MB per dataset, and regenerated exactly by
# scripts/record_dataset.py. The timestamps, intrinsics and flight streams
# that describe them are committed next to them in the same dataset folder.
results/**/dataset_*/images/
VIDEO_RUN.md
